{
  "name": "feynos-music",
  "productName": "Feynos Music",
  "version": "1.0.0",
  "description": "Navidrome music player for Linux and Windows with ListenBrainz history, weekly mixes and jams",
  "homepage": "https://github.com/Feynos-Lin/FeynosMusic",
  "author": {
    "name": "Feynos",
    "email": "feynos@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux rpm --publish never"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.feynos.music.desktop",
    "productName": "Feynos Music",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "linux": {
      "target": [
        "rpm"
      ],
      "icon": "build/icon.png",
      "category": "Audio",
      "synopsis": "Navidrome music player",
      "executableName": "feynos-music"
    },
    "rpm": {
      "packageName": "feynos-music",
      "depends": [
        "libnotify",
        "libXScrnSaver",
        "nss",
        "alsa-lib"
      ],
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Feynos-Music-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Feynos Music",
      "uninstallDisplayName": "Feynos Music"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Feynos-Lin/FeynosMusic.git"
  }
}
